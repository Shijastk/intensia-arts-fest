{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || (auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'))",
        "role": {
          ".validate": "newData.val() === 'admin'"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "isActive": {
          ".validate": "(newData.isBoolean() && (((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || newData.val() === data.val()))"
        },
        "festId": {
          ".validate": "(newData.isString() && (((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || newData.val() === data.val() || root.child('fests').child(newData.val()).child('adminUid').val() === auth.uid))"
        },
        "$other": {
          ".validate": "((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))"
        }
      }
    },
    "superAdmins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "fests": {
      ".read": "((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))",
      "$festId": {
        ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || ((auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('users').child(auth.uid).child('isActive').val() !== false) && !data.exists() && newData.child('adminUid').val() === auth.uid))",
        "name": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || ((auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('users').child(auth.uid).child('isActive').val() !== false) && root.child('fests').child($festId).child('adminUid').val() === auth.uid) || root.child('fests').child($festId).child('adminUid').exists())",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "adminUid": {
          ".read": true,
          ".validate": "(newData.isString() && (!data.exists() || newData.val() === data.val() || ((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))))"
        },
        "createdAt": {
          ".read": true
        },
        "settings": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || root.child('fests').child($festId).child('adminUid').exists())"
        },
        "customFonts": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || root.child('fests').child($festId).child('adminUid').exists())",
          "$fontId": {
            ".validate": "newData.hasChildren(['family', 'dataUrl'])",
            "family": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9 _-]{1,60}$/)"
            },
            "dataUrl": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:') && newData.val().length <= 1500000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "students": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || root.child('fests').child($festId).child('adminUid').exists())",
          "$studentId": {
            ".validate": "newData.hasChildren(['name'])"
          }
        },
        "staff": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || root.child('fests').child($festId).child('adminUid').exists())",
          "$staffId": {
            ".validate": "newData.hasChildren(['username', 'role'])",
            "role": {
              ".validate": "newData.isString() && newData.val().matches(/^(GREEN_ROOM|JUDGE|TEAM_LEADER|ADMIN)$/)"
            },
            "username": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "passwordHash": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
            },
            "passwordSalt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/)"
            },
            "password": {
              ".validate": false
            }
          }
        },
        "programs": {
          ".read": true,
          ".write": "(((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true)) || root.child('fests').child($festId).child('adminUid').exists())",
          "$programId": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(PENDING|JUDGING|COMPLETED|CANCELLED)$/)"
            },
            "isPublished": {
              ".validate": "newData.isBoolean()"
            },
            "isResultPublished": {
              ".validate": "newData.isBoolean()"
            },
            "resultPublishedOrder": {
              ".validate": "newData.isNumber()"
            },
            "isAllocatedToJudge": {
              ".validate": "newData.isBoolean()"
            },
            "judgePanel": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            }
          }
        }
      }
    },
    "publicFests": {
      "$festId": {
        ".read": true,
        ".write": "((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))"
      }
    },
    "staffSecrets": {
      ".read": false,
      ".write": "((auth != null && auth.token.superAdmin === true) || (auth != null && root.child('superAdmins').child(auth.uid).val() === true))"
    }
  }
}
